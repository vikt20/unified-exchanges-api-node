{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "binance/**/*",
    "core/**/*",
    "bybit/**/*",
    "okx/**/*",
    "bitget/**/*",
    "testing/**/*",
    "test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "archive/**/*"
  ]
}
